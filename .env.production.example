# NORMI — production settings TEMPLATE (docs/DEPLOYMENT.md).
# Copy to .env on the production server and fill in the blanks there.
# This file holds NO real secrets and must never hold any: the real .env is
# git-ignored and stays on the server. Every key not listed here falls back
# to the value documented in .env.example.

APP_NAME="NORMI - Well-Being Assessment"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
# The address staff open. HTTPS (see SESSION_SECURE_COOKIE below).
APP_URL=https://normi.example.school.edu.ph

# APP_KEY — KEY CUSTODY. Generate it ONCE on the server
# (php artisan key:generate --show, then paste it here) and NEVER change it
# casually: every encrypted score, answer, counseling note and student-device
# draft is unreadable without the key that wrote it. Keep a copy OUTSIDE the
# server (password manager or a sealed envelope held by the named custodian),
# separate from the database backups. If the key ever has to change, put the
# old one in APP_PREVIOUS_KEYS so existing data still decrypts.
APP_KEY=
# Old keys (comma-separated "base64:..."), used only to DECRYPT older data.
# Empty unless a key rotation is in progress.
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One log file per day, kept 14 days; warnings and errors only.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=student_mental_health_system
# A dedicated, least-privilege database user (no CREATE DATABASE / GRANT).
DB_USERNAME=
DB_PASSWORD=

# Only for the very first `php artisan db:seed` (creates the first
# Psychometrician). Remove it from .env afterwards, and change that account's
# password at the first login.
ADMIN_DEFAULT_PASSWORD=

# AI classification. rule_based (recommended default): classifies with the
# official thresholds only, nothing leaves the server. claude: the three
# scores and the thresholds (never a name or any identity) are sent to
# Anthropic's API, a cross-border transfer the school's Data Protection
# Officer must approve first; every Claude result is cross-checked against
# rule_based anyway, so the saved classification is the same either way.
AI_PROVIDER=rule_based
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_TIMEOUT=12
CLAUDE_CONNECT_TIMEOUT=4

# Student device (/s). See SYSTEM_DOCUMENTATION.md "Student Device Assessment".
REMOTE_ASSESSMENT_STUDENT_ENTRY_ONLY=true
# The address the STUDENT PC opens (this server's HTTPS name or LAN address),
# never 127.0.0.1 / localhost.
REMOTE_ASSESSMENT_URL=https://normi.example.school.edu.ph
# The guidance office's student PC(s) only: fixed IPs / DHCP reservations,
# comma-separated, IPv4/IPv6/CIDR. Every other address gets the generic 404.
REMOTE_ASSESSMENT_ALLOWED_IPS=
REMOTE_ASSESSMENT_TTL_MINUTES=60
REMOTE_ASSESSMENT_LOCKED_GRACE_MINUTES=15
# "Add 15 minutes" on the live page: minutes added per press, and the most
# a draft can last from its creation (never extended after Done).
REMOTE_ASSESSMENT_EXTEND_MINUTES=15
REMOTE_ASSESSMENT_MAX_LIFETIME_MINUTES=120
# The privacy notice on the device is a PLACEHOLDER until the DPO approves
# the text (lang/en/student_device.php). Keep consent on.
REMOTE_ASSESSMENT_STUDENT_CONSENT=true
REMOTE_ASSESSMENT_POLL_INTERVAL_MS=1500

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true REQUIRES HTTPS: over plain HTTP the browser drops the session cookie
# and every form POST fails with 419 (staff logins from other PCs break).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Password-reset e-mail. Leave MAIL_MAILER=log if staff passwords are reset
# only by a Psychometrician in User Management.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
