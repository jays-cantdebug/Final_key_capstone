APP_NAME="NORMI - Well-Being Assessment"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Required before running UserSeeder (php artisan db:seed / migrate:fresh --seed):
# the password for the default Super Admin Psychometrician account. There is
# no hardcoded fallback — the seeder throws if this is unset. Change the
# account's password immediately after first login.
ADMIN_DEFAULT_PASSWORD=

# AI Prediction Module (see config/ai.php). "rule_based" (default) classifies
# purely by querying classification_thresholds — no external API involved.
# "claude" sends the same thresholds to the Claude API and cross-checks its
# response against the rule-based result before trusting it (see
# App\AI\Providers\ClaudeAIProvider). The test suite always forces
# AI_PROVIDER=rule_based via phpunit.xml, regardless of this value.
AI_PROVIDER=rule_based
CLAUDE_API_KEY=
# CLAUDE_MODEL must support a forced tool call (tool_choice naming a tool);
# some newer models reject one, which makes every request silently fall back
# to rule_based. Verify any new value with a live check first (see "Choosing
# CLAUDE_MODEL" in SYSTEM_DOCUMENTATION.md).
CLAUDE_MODEL=claude-sonnet-5

# Student-device assessment (New Assessment Step 2, "Send to student device";
# see config/remote_assessment.php and "Student Device Assessment" in
# SYSTEM_DOCUMENTATION.md).
# The address the student device opens, shown as text and in the QR code.
# It must be reachable FROM THE STUDENT PC: this server's LAN IP or domain,
# e.g. http://192.168.1.10 or https://normi.school.edu.ph. Never 127.0.0.1 or
# localhost (that is the student PC itself; the live page warns). Empty =
# APP_URL.
REMOTE_ASSESSMENT_URL=
# Fixed lifetime of a draft, in minutes (not extended by activity).
REMOTE_ASSESSMENT_TTL_MINUTES=60
# After the student presses Done, keep the draft at least this long so the
# Psychometrician can review and submit (never shortens a longer expiry).
REMOTE_ASSESSMENT_LOCKED_GRACE_MINUTES=15
# The student acknowledges the data privacy notice on their own screen
# before the first question. The notice text in lang/en/student_device.php
# is a PLACEHOLDER to be replaced by the DPO's approved text.
REMOTE_ASSESSMENT_STUDENT_CONSENT=true
# How often the Psychometrician's live page polls, in milliseconds.
REMOTE_ASSESSMENT_POLL_INTERVAL_MS=1500
# Rate limits, per minute. Failed code/token attempts are limited per IP
# (successful claims never count, so a class behind one school NAT isn't
# locked out); page loads and actions are per device cookie, or per IP for a
# browser without one.
REMOTE_ASSESSMENT_FAILED_ENTRY_PER_MINUTE=10
REMOTE_ASSESSMENT_PAGES_PER_MINUTE=300
REMOTE_ASSESSMENT_DEVICE_PAGES_PER_MINUTE=60
REMOTE_ASSESSMENT_ACTIONS_PER_MINUTE=180
REMOTE_ASSESSMENT_MONITOR_PER_MINUTE=120

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production should use true. With the database driver, each session's
# payload sits in the `sessions` table, including an in-progress New
# Assessment (student name, answers, scores, the AI's proposed levels) until
# it is saved, cleared or expires. true encrypts that payload with APP_KEY
# (AES-256-CBC + HMAC); id, user_id, ip_address, user_agent and
# last_activity stay plain, so single-session enforcement and Force Logout
# work unchanged. Switching it on logs every existing session out on its
# next request (and loses any wizard in progress); until then, or until it
# expires, such a session still counts as active and blocks a login from
# another browser. Switch while nobody is signed in, or clear the `sessions`
# table at the same time.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Must be true once the app is served over HTTPS in production — without it,
# the session cookie can be sent back over a plain HTTP connection. Leave
# false only for local HTTP development.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# This project sends mail via Brevo's SMTP relay. Get MAIL_USERNAME and
# MAIL_PASSWORD from the Brevo dashboard under SMTP & API > SMTP (the SMTP
# key, not your Brevo account password), and verify MAIL_FROM_ADDRESS's
# sending domain in Brevo (SPF/DKIM) or deliverability will suffer. Fall
# back to MAIL_MAILER=log for local development with no mail account set up.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
